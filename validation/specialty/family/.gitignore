# Plan B Tier 3 / Agent C3 — within-family harness
# Markers + caches (regenerated by install.sh)
.install_marker
.ref_tool
.cache_install.log
.cache/

# Simulated fixtures (regenerated by fetch_data.sh; seed=42)
data/

# Reference outputs (regenerated by run.sh)
outputs/

# results/ is intentionally NOT ignored — summary.tsv + agreement.json +
# manifest.sha256 are the per-PR comparison record.

# Override root gitignore (root has results/ ignored)
!results/
!results/*.tsv
!results/*.json
!results/*.sha256
